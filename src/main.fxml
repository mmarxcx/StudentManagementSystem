<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller">
   <children>
      <TextField fx:id="txtName" layoutX="165.0" layoutY="14.0" />
      <TextField fx:id="txtCourse" layoutX="165.0" layoutY="50.0" />
      <Label layoutX="115.0" layoutY="18.0" text="Name" />
      <Label layoutX="113.0" layoutY="54.0" text="Course" />
      <ChoiceBox fx:id="cbYear" layoutX="184.0" layoutY="86.0" prefWidth="130.0" />
      <Button layoutX="128.0" layoutY="125.0" mnemonicParsing="false" onAction="#addStudent" text="Add" />
      <Button layoutX="181.0" layoutY="125.0" mnemonicParsing="false" onAction="#updateStudent" text="Update" />
      <Button layoutX="248.0" layoutY="125.0" mnemonicParsing="false" onAction="#deleteStudent" text="Delete" />
      <Button layoutX="315.0" layoutY="125.0" mnemonicParsing="false" onAction="#clearFields" text="Clear" />
      <TableView fx:id="table" layoutX="140.0" layoutY="198.0" prefHeight="200.0" prefWidth="300.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="colYear" prefWidth="75.0" text="Year" />
          <TableColumn fx:id="colCourse" prefWidth="75.0" text="Course" />
        </columns>
      </TableView>
      <Label layoutX="113.0" layoutY="90.0" text="Year Level" />
   </children>
</AnchorPane>
